{
  "manifest_version": 3,
  "name": "UNFAIR",
  "version": "1.0.0",
  "description": "Monitor AI usage with UNFAIR",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}

