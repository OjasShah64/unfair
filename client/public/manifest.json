{
  "manifest_version": 3,
  "name": "UNFAIR",
  "version": "1.0.0",
  "description": "Monitor AI usage with UNFAIR",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "clipboardRead",
    "clipboardWrite"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UNFAIR"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}


